# Anthropic API key for the default model
ANTHROPIC_API_KEY=
# TypeSafe API key (Jev judgments in the policy engine)
TYPESAFE_API_KEY=
# LiteLLM model id; use ollama/qwen3:8b for the local injection beat
PCAGENT_MODEL=anthropic/claude-opus-5-5
# Postgres URL for the LangGraph checkpointer (unset = in-memory checkpoints)
# DATABASE_URL=postgresql://pcagent:pcagent@localhost:5432/pcagent
# Tracing is configured in pcagent.yaml (tracing.exporter); see docs/guide/config.md.
