# Anthropic API key for the default model
ANTHROPIC_API_KEY=
# TypeSafe API key (Jev judgments in the policy engine)
TYPESAFE_API_KEY=
# LiteLLM model id; use ollama/qwen3:8b for the local injection beat
PCAGENT_MODEL=anthropic/claude-opus-5-5
# Postgres URL for the LangGraph checkpointer
DATABASE_URL=
# Langfuse tracing public key
LANGFUSE_PUBLIC_KEY=
# Langfuse tracing secret key
LANGFUSE_SECRET_KEY=
# Langfuse host URL
LANGFUSE_HOST=https://cloud.langfuse.com
